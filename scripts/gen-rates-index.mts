/**
 * Writes src/data/rates/index.ts: one static import per state rate file, so the bundler can see every file.
 *   npm run gen:rates      (run it after adding a state file; the rates test fails if the index is stale)
 */
import { readdirSync, writeFileSync } from "node:fs";
import { join } from "node:path";

const dir = join(import.meta.dirname, "..", "src", "data", "rates");
const codes = readdirSync(dir)
  .map((f) => /^([a-z]{2})-\d{4}\.json$/.exec(f))
  .filter((m): m is RegExpExecArray => m !== null && m[1] !== "fe") // federal-2026.json does not match: two letters only
  .map((m) => ({ code: m[1].toUpperCase(), file: m[0] }))
  .sort((a, b) => a.code.localeCompare(b.code));

const lines = [
  "// Generated by scripts/gen-rates-index.mts. Do not edit by hand: run `npm run gen:rates`.",
  ...codes.map(({ code, file }) => `import ${code.toLowerCase()}Json from "./${file}";`),
  "",
  "/** Raw state rate files by postal code. Validated against the schema in src/lib/rates.ts. */",
  "export const stateRateFiles = {",
  ...codes.map(({ code }) => `  ${code}: ${code.toLowerCase()}Json,`),
  "} as const;",
  "",
];
writeFileSync(join(dir, "index.ts"), lines.join("\n"));
console.log(`Registered ${codes.length} state rate files.`);
