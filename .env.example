# Copy to .env.local for local work. Never commit .env.local.

# Public site URL (canonical links, sitemap, JSON-LD).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Publish states whose rate files have no human sign-off yet. Local and preview only. LEAVE UNSET IN PRODUCTION.
NEXT_PUBLIC_ALLOW_UNVERIFIED=1

# Production indexing is automatic on Vercel (VERCEL_ENV=production). Set to 1 only for self-hosted production.
# NEXT_PUBLIC_INDEXABLE=1

# Ads stay off until AdSense approves the site.
# NEXT_PUBLIC_ADS_ENABLED=1
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx

# Inbox shown on /contact. Create this mailbox before launch.
# NEXT_PUBLIC_CONTACT_EMAIL=hello@paycheckdecoder.com
